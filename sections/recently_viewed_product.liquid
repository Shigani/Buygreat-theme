{{ 'product-card-item.css' | asset_url | stylesheet_tag }}
{{ 'section-featured-collection.css' | asset_url | stylesheet_tag }}
{{ 'gallery-demo.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign productShowXl = section.settings.products_show_on_xl
  assign productShowSm = section.settings.products_show_on_sm
  assign slideAutoplay = section.settings.auto_rotate
  assign autoplay_time = section.settings.autoplay_time
  assign showPagination = section.settings.show_pagination
  assign showNavigation = section.settings.show_navigation
-%}

<div
  class="buygreat-trending-products buygreat-recently-viewed-products recently_viewed_proudct no-js-inline color-{{ section.settings.color_scheme }} gradient"
  data-product-handle="{{ product.handle }}"
  data-section-id="{{ section.id }}"
  data-section-type="recently-viewed"
  data-slider-enable="true"
  data-slider-loop="false"
  data-show-mobile="{{ productShowSm }}"
  data-show-extra-large="{{ productShowXl }}"
  data-slider-space="0"
  data-autoplay="{{ slideAutoplay }}"
  data-autoplay-time="{{ autoplay_time }}000"
>
  <div class="container">
    <h2 class="product-recommendations__heading h2">
      {{ section.settings.heading | escape }}
    </h2>
    {%- if section.blocks.size > 0 -%}
      <template data-recently-viewed-app-template>
        {%- for block in section.blocks -%}
          <div class="buygreat-recently-viewed-app-block" {{ block.shopify_attributes }}>
            {% render block %}
          </div>
        {%- endfor -%}
      </template>
    {%- endif -%}
    <div class="relative product_slider_wrapper">
      <div class="productSlider swiper" role="list">
        <div class="swiper-wrapper" grid-recentViewProduct></div>
      </div>
      {%- if showNavigation or showPagination -%}
        <div class="featured__collection--slider slider--controls--button">
          {%- if showNavigation -%}
            <div class="swiper-button-prev product__slider--buton" aria-label="Previous products"></div>
          {%- endif -%}
          {%- if showPagination -%}
            <div class="swiper-pagination product__slider--pagination"></div>
          {%- endif -%}
          {%- if showNavigation -%}
            <div class="swiper-button-next product__slider--buton" aria-label="Next products"></div>
          {%- endif -%}
        </div>
      {%- endif -%}
    </div>
  </div>
</div>

<script src="{{ 'recently_viewed_product.js' | asset_url }}" defer></script>
{% schema %}
{
  "name": "Recently viewed products",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.colors.label",
      "default": "accent-1"
    },
    {
      "type": "text",
      "id": "heading",
      "default": "Recently viewed",
      "label": "Heading"
    },
 {
      "type": "select",
      "id": "heading_size",
      "options": [
        {
          "value": "h2",
          "label": "Small"
        },
        {
          "value": "h1",
          "label": "Medium"
        },
        {
          "value": "h0",
          "label": "Large"
        }
      ],
      "default": "h2",
      "label": "Heading size"
    },
 {
        "type": "select",
        "id": "text_align",
        "label": "Alignment",
        "default": "center",
        "options": [
          {
            "value": "center",
            "label": "Center"
          },
          {
            "value": "left",
            "label": "Left"
          },
          {
            "value": "right",
            "label": "Right"
          }
        ]
      },
    {
      "type": "header",
      "content": "Grid settings"
    },
    {
      "type": "select",
      "id": "products_show_on_xl",
      "label": "Number of columns on desktop",
      "options": [
        {
          "value": "2",
          "label": "2"
        },
        {
          "value": "3",
          "label": "3"
        },
        {
          "value": "4",
          "label": "4"
        },
        {
          "value": "5",
          "label": "5"
        },
        {
          "value": "6",
          "label": "6"
        }
      ],
      "default": "6"
    },
   {
      "type": "select",
      "id": "products_show_on_sm",
      "label": "Number of columns on mobile",
      "options": [
        {
          "value": "1.5",
          "label": "1.5"
        },
        {
          "value": "2",
          "label": "2"
        }
      ],
      "default": "2"
    },
    {
      "type": "header",
      "content": "Slider settings"
    },
    {
        "type": "checkbox",
        "id": "show_pagination",
        "label": "Show pagination",
        "default": true
    },
    {
        "type": "checkbox",
        "id": "show_navigation",
        "label": "Show navigation",
        "default": true
    },
	{
      "type": "checkbox",
      "id": "auto_rotate",
      "label": "Auto-rotate slides",
      "default": false
    },
    {
      "type": "range",
      "id": "autoplay_time",
      "min": 2,
      "max": 9,
      "step": 1,
      "unit": "s",
      "label": "Change slides every",
      "default": 3
    }
  ],
  "blocks": [
    {
      "type": "@app"
    }
  ]
}
{% endschema %}

