            "default": "footer",
            "label": "Menu",
            "info": "Displays only top-level menu items."
          },
          {
            "type": "checkbox",
            "id": "show_social_icons",
            "default": false,
            "label": "Show social icons",
            "info": "Show social icons within the block. To show social icons footer-wide, enable social icons in section setting."
          }
        ]
      },
