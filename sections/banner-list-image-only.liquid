{%- style -%}
  .section-{{ section.id }}-image-only-padding {
    padding-top: 40px;
    padding-bottom: 52px;
  }

  @media screen and (max-width: 749px) {
    .section-{{ section.id }}-image-only-padding {
      padding-top: 0;
      padding-bottom: 0;
    }
  }

  .section-{{ section.id }}-image-only .banner_list_item--media {
    border-radius: 0;
  }

  .section-{{ section.id }}-image-only .banner-grid.mosaic_column {
    grid-template-columns: repeat(12, minmax(0, 1fr));
  }

  .section-{{ section.id }}-image-only .banner-grid.mosaic_column .mosaic_item {
    grid-column: span 6;
  }

  @media screen and (max-width: 992px) {
    .section-{{ section.id }}-image-only .banner-grid.mosaic_column .mosaic_item {
      grid-column: 1 / -1;
    }
  }
{%- endstyle -%}

{{ 'banner-list.css' | asset_url | stylesheet_tag }}

<div class="banner-list-wrapper banner-list-image-only">
  <div class="section-{{ section.id }}-image-only section-{{ section.id }}-image-only-padding color-background-1 gradient">
    <div class="container">
      {%- liquid
        assign highest_ratio = 0
        for block in section.blocks
          if block.settings.image != blank and block.settings.image.aspect_ratio > highest_ratio
            assign highest_ratio = block.settings.image.aspect_ratio
          endif
        endfor

        if highest_ratio == 0
          assign highest_ratio = 1
        endif
      -%}

      <div class="banner-grid banner_grid_gap--{{ section.settings.banner_grid_gap }} {% if section.settings.banner_layout_type == 'mosaic' %}mosaic_column{% else %}grid-colums-{{ section.settings.section-colums-desktop }}{% endif %}">
        {% for block in section.blocks %}
          <div class="banner_list_item{% if section.settings.banner_layout_type == 'mosaic' %} mosaic_item{% endif %}" {{ block.shopify_attributes }}>
            {% if block.settings.link != blank %}
              <a href="{{ block.settings.link }}" class="d-block">
            {% else %}
              <div class="d-block">
            {% endif %}
              <div
                class="banner_list_item--media media media--transparent media--adapt"
                style="padding-bottom: {{ 1 | divided_by: highest_ratio | times: 100 }}%;"
              >
                {% if block.settings.image != blank %}
                  {{
                    block.settings.image
                    | image_url: width: 2200
                    | image_tag:
                      loading: 'lazy',
                      widths: '375, 550, 750, 850, 1100, 1500, 1780, 2000, 2200',
                      sizes: '(min-width: 992px) calc((100vw - 160px) / 4), (min-width: 580px) calc((100vw - 100px) / 2), calc(100vw - 30px)',
                      alt: block.settings.image.alt
                  }}
                {% else %}
                  {{ 'collection-apparel-1' | placeholder_svg_tag: 'placeholder-svg' }}
                {% endif %}
              </div>
            {% if block.settings.link != blank %}
              </a>
            {% else %}
              </div>
            {% endif %}
          </div>
        {% endfor %}
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Banner list image only",
  "tag": "section",
  "class": "section",
  "max_blocks": 12,
  "settings": [
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "select",
      "id": "banner_layout_type",
      "options": [
        {
          "value": "grid",
          "label": "Grid"
        },
        {
          "value": "mosaic",
          "label": "Mosaic"
        }
      ],
      "default": "grid",
      "label": "Desktop layout banner type"
    },
    {
      "type": "range",
      "id": "section-colums-desktop",
      "min": 1,
      "max": 5,
      "step": 1,
      "default": 4,
      "label": "Number of columns on desktop"
    },
    {
      "type": "select",
      "id": "banner_grid_gap",
      "options": [
        {
          "value": "no-gap",
          "label": "No gap"
        },
        {
          "value": "small",
          "label": "Small"
        },
        {
          "value": "medium",
          "label": "Medium"
        },
        {
          "value": "large",
          "label": "Large"
        }
      ],
      "default": "medium",
      "label": "Column space"
    }
  ],
  "blocks": [
    {
      "type": "image",
      "name": "Image",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Banner list image only",
      "blocks": [
        {
          "type": "image"
        },
        {
          "type": "image"
        },
        {
          "type": "image"
        },
        {
          "type": "image"
        }
      ]
    }
  ]
}
{% endschema %}

