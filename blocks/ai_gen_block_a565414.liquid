{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% liquid
  assign collection = block.settings.collection
  assign max_products = block.settings.max_products
  assign desktop_columns = block.settings.desktop_columns
  assign mobile_columns = block.settings.mobile_columns
  assign auto_rotate = block.settings.auto_rotate
  assign slide_interval = block.settings.slide_interval
  assign show_arrows_desktop = block.settings.show_arrows_desktop
  assign show_arrows_mobile = block.settings.show_arrows_mobile
  assign show_title = block.settings.show_title
  assign show_price = block.settings.show_price
  assign show_vendor = block.settings.show_vendor
  assign show_rating = block.settings.show_rating
  assign show_badges = block.settings.show_badges
  assign show_savings = block.settings.show_savings
  assign show_add_to_cart = block.settings.show_add_to_cart
  assign card_bg_color = block.settings.card_bg_color
  assign text_color = block.settings.text_color
  assign accent_color = block.settings.accent_color
  assign button_bg_color = block.settings.button_bg_color
  assign button_text_color = block.settings.button_text_color
  assign border_radius = block.settings.border_radius
  assign card_spacing = block.settings.card_spacing
  assign shadow_intensity = block.settings.shadow_intensity
  assign padding_top = block.settings.padding_top
  assign padding_bottom = block.settings.padding_bottom
  assign container_padding_left = block.settings.container_padding_left
  assign container_padding_right = block.settings.container_padding_right
%}

{% style %}
  .ai-carousel-{{ai_gen_id}} {
    display: block;
    width: 100%;
    padding: {{ padding_top }}px 0 {{ padding_bottom }}px 0;
    overflow: hidden;
  }

  .ai-carousel-container-{{ai_gen_id}} {
    position: relative;
    width: 100%;
    padding-left: {{ container_padding_left }}px;
    padding-right: {{ container_padding_right }}px;
  }

  .ai-carousel-title-{{ai_gen_id}} {
    margin: 0 0 24px;
    color: {{ text_color }};
    text-align: center;
  }

  .ai-carousel-wrapper-{{ai_gen_id}} {
    position: relative;
  }

  .ai-carousel-track-{{ai_gen_id}} {
    display: flex;
    gap: {{ card_spacing }}px;
    overflow-x: auto;
    scroll-behavior: smooth;
    scroll-snap-type: x mandatory;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: none;
    -ms-overflow-style: none;
  }

  .ai-carousel-track-{{ai_gen_id}}::-webkit-scrollbar {
    display: none;
  }

  .ai-carousel-card-{{ai_gen_id}} {
    flex: 0 0 calc((100% - ({{ card_spacing }}px * ({{ mobile_columns }} - 1))) / {{ mobile_columns }});
    scroll-snap-align: start;
    background-color: {{ card_bg_color }};
    border-radius: {{ border_radius }}px;
    overflow: hidden;
    box-shadow: 0 {{ shadow_intensity }}px {{ shadow_intensity | times: 2 }}px rgba(0, 0, 0, {{ shadow_intensity | times: 0.02 }});
    transition: transform 0.3s ease, box-shadow 0.3s ease;
  }

  .ai-carousel-card-{{ai_gen_id}}:hover {
    transform: translateY(-4px);
    box-shadow: 0 {{ shadow_intensity | times: 1.5 }}px {{ shadow_intensity | times: 3 }}px rgba(0, 0, 0, {{ shadow_intensity | times: 0.03 }});
  }

  .ai-carousel-image-wrapper-{{ai_gen_id}} {
    position: relative;
    width: 100%;
    padding-bottom: 100%;
    overflow: hidden;
    background-color: #f4f4f4;
  }

  .ai-carousel-image-{{ai_gen_id}} {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.5s ease;
  }

  .ai-carousel-card-{{ai_gen_id}}:hover .ai-carousel-image-{{ai_gen_id}} {
    transform: scale(1.05);
  }

  .ai-carousel-image-placeholder-{{ai_gen_id}} {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
  }

  .ai-carousel-image-placeholder-{{ai_gen_id}} svg {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .ai-carousel-badges-{{ai_gen_id}} {
    position: absolute;
    top: 8px;
    left: 8px;
    display: flex;
    flex-direction: column;
    gap: 4px;
    z-index: 2;
  }

  .ai-carousel-badge-{{ai_gen_id}} {
    padding: 4px 8px;
    font-size: 11px;
    font-weight: 600;
    border-radius: 4px;
    text-transform: uppercase;
    letter-spacing: 0.5px;
  }

  .ai-carousel-badge-sale-{{ai_gen_id}} {
    background-color: {{ accent_color }};
    color: #ffffff;
  }

  .ai-carousel-badge-soldout-{{ai_gen_id}} {
    background-color: #666666;
    color: #ffffff;
  }

  .ai-carousel-content-{{ai_gen_id}} {
    padding: 16px;
  }

  .ai-carousel-vendor-{{ai_gen_id}} {
    font-size: 12px;
    color: {{ text_color }};
    opacity: 0.6;
    margin-bottom: 4px;
    text-transform: uppercase;
    letter-spacing: 0.5px;
  }

  .ai-carousel-product-title-{{ai_gen_id}} {
    font-size: 14px;
    font-weight: 500;
    color: {{ text_color }};
    margin: 0 0 8px;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .ai-carousel-product-title-{{ai_gen_id}} a {
    color: inherit;
    text-decoration: none;
  }

  .ai-carousel-rating-{{ai_gen_id}} {
    display: flex;
    align-items: center;
    gap: 4px;
    margin-bottom: 8px;
    font-size: 12px;
    color: {{ accent_color }};
  }

  .ai-carousel-price-wrapper-{{ai_gen_id}} {
    margin-bottom: 12px;
  }

  .ai-carousel-price-{{ai_gen_id}} {
    font-size: 18px;
    font-weight: 600;
    color: {{ text_color }};
  }

  .ai-carousel-compare-price-{{ai_gen_id}} {
    font-size: 14px;
    color: {{ text_color }};
    opacity: 0.5;
    text-decoration: line-through;
    margin-left: 8px;
  }

  .ai-carousel-savings-{{ai_gen_id}} {
    display: inline-block;
    font-size: 12px;
    color: {{ accent_color }};
    font-weight: 600;
    margin-top: 4px;
  }

  .ai-carousel-add-to-cart-{{ai_gen_id}} {
    width: 100%;
    padding: 12px 16px;
    background-color: {{ button_bg_color }};
    color: {{ button_text_color }};
    border: none;
    border-radius: {{ border_radius }}px;
    font-size: 14px;
    font-weight: 600;
    cursor: pointer;
    transition: opacity 0.3s ease, transform 0.2s ease;
    text-transform: uppercase;
    letter-spacing: 0.5px;
  }

  .ai-carousel-add-to-cart-{{ai_gen_id}}:hover:not(:disabled) {
    opacity: 0.9;
    transform: translateY(-1px);
  }

  .ai-carousel-add-to-cart-{{ai_gen_id}}:disabled {
    opacity: 0.5;
    cursor: not-allowed;
  }

  .ai-carousel-arrow-{{ai_gen_id}} {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    width: 44px;
    height: 44px;
    background-color: {{ card_bg_color }};
    border: 2px solid {{ text_color }};
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    z-index: 3;
    opacity: 0.9;
    transition: opacity 0.3s ease, transform 0.2s ease;
  }

  .ai-carousel-arrow-{{ai_gen_id}}:hover {
    opacity: 1;
    transform: translateY(-50%) scale(1.1);
  }

  .ai-carousel-arrow-left-{{ai_gen_id}} {
    left: 10px;
  }

  .ai-carousel-arrow-right-{{ai_gen_id}} {
    right: 10px;
  }

  .ai-carousel-arrow-{{ai_gen_id}} svg {
    width: 20px;
    height: 20px;
    fill: {{ text_color }};
  }

  @media screen and (min-width: 750px) {
    .ai-carousel-card-{{ai_gen_id}} {
      flex: 0 0 calc((100% - ({{ card_spacing }}px * 2)) / 3);
    }

    .ai-carousel-product-title-{{ai_gen_id}} {
      font-size: 16px;
    }

    .ai-carousel-content-{{ai_gen_id}} {
      padding: 20px;
    }
  }

  @media screen and (min-width: 990px) {
    .ai-carousel-card-{{ai_gen_id}} {
      flex: 0 0 calc((100% - ({{ card_spacing }}px * ({{ desktop_columns }} - 1))) / {{ desktop_columns }});
    }
  }

  @media screen and (max-width: 749px) {
    .ai-carousel-arrow-{{ai_gen_id}} {
      display: {% if show_arrows_mobile %}flex{% else %}none{% endif %};
    }
  }

  @media screen and (min-width: 750px) {
    .ai-carousel-arrow-{{ai_gen_id}} {
      display: {% if show_arrows_desktop %}flex{% else %}none{% endif %};
    }
  }

  {{ block.settings.custom_css }}
{% endstyle %}

<featured-carousel-{{ai_gen_id}} class="ai-carousel-{{ai_gen_id}}" {{ block.shopify_attributes }}>
  <div class="ai-carousel-container-{{ai_gen_id}}">
    {% if block.settings.section_title != blank %}
      <h2 class="ai-carousel-title-{{ai_gen_id}}">{{ block.settings.section_title }}</h2>
    {% endif %}

    <div class="ai-carousel-wrapper-{{ai_gen_id}}">
      {% if show_arrows_desktop or show_arrows_mobile %}
        <button class="ai-carousel-arrow-{{ai_gen_id}} ai-carousel-arrow-left-{{ai_gen_id}}" aria-label="Previous products" type="button">
          <svg viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
            <path d="M15 18l-6-6 6-6"/>
          </svg>
        </button>
        <button class="ai-carousel-arrow-{{ai_gen_id}} ai-carousel-arrow-right-{{ai_gen_id}}" aria-label="Next products" type="button">
          <svg viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
            <path d="M9 18l6-6-6-6"/>
          </svg>
        </button>
      {% endif %}

      <div class="ai-carousel-track-{{ai_gen_id}}" role="region" aria-label="Product carousel">
        {% if collection != blank and collection.products.size > 0 %}
          {% for product in collection.products limit: max_products %}
            <div class="ai-carousel-card-{{ai_gen_id}}" data-product-id="{{ product.id }}">
              <div class="ai-carousel-image-wrapper-{{ai_gen_id}}">
                {% if product.featured_image %}
                  <img
                    src="{{ product.featured_image | image_url: width: 600 }}"
                    alt="{{ product.featured_image.alt | escape }}"
                    class="ai-carousel-image-{{ai_gen_id}}"
                    loading="lazy"
                    width="600"
                    height="600"
                  >
                {% else %}
                  <div class="ai-carousel-image-placeholder-{{ai_gen_id}}">
                    {{ 'product-1' | placeholder_svg_tag }}
                  </div>
                {% endif %}

                {% if show_badges %}
                  <div class="ai-carousel-badges-{{ai_gen_id}}">
                    {% if product.available == false %}
                      <span class="ai-carousel-badge-{{ai_gen_id}} ai-carousel-badge-soldout-{{ai_gen_id}}">Sold Out</span>
                    {% elsif product.compare_at_price > product.price %}
                      <span class="ai-carousel-badge-{{ai_gen_id}} ai-carousel-badge-sale-{{ai_gen_id}}">Sale</span>
                    {% endif %}
                  </div>
                {% endif %}
              </div>

              <div class="ai-carousel-content-{{ai_gen_id}}">
                {% if show_vendor and product.vendor != blank %}
                  <div class="ai-carousel-vendor-{{ai_gen_id}}">{{ product.vendor }}</div>
                {% endif %}

                {% if show_title %}
                  <h3 class="ai-carousel-product-title-{{ai_gen_id}}">
                    <a href="{{ product.url }}">{{ product.title }}</a>
                  </h3>
                {% endif %}

                {% if show_rating %}
                  <div class="ai-carousel-rating-{{ai_gen_id}}" role="img" aria-label="Rating: 4.5 out of 5 stars">
                    ★★★★☆ <span style="opacity: 0.6;">(4.5)</span>
                  </div>
                {% endif %}

                {% if show_price %}
                  <div class="ai-carousel-price-wrapper-{{ai_gen_id}}">
                    <span class="ai-carousel-price-{{ai_gen_id}}">{{ product.price | money }}</span>
                    {% if product.compare_at_price > product.price %}
                      <span class="ai-carousel-compare-price-{{ai_gen_id}}">{{ product.compare_at_price | money }}</span>
                      {% if show_savings %}
                        {% assign savings = product.compare_at_price | minus: product.price %}
                        <div class="ai-carousel-savings-{{ai_gen_id}}">Save {{ savings | money }}</div>
                      {% endif %}
                    {% endif %}
                  </div>
                {% endif %}

                {% if show_add_to_cart %}
                  <button
                    class="ai-carousel-add-to-cart-{{ai_gen_id}}"
                    data-variant-id="{{ product.selected_or_first_available_variant.id }}"
                    {% unless product.available %}disabled{% endunless %}
                    aria-label="Add {{ product.title }} to cart"
                    type="button"
                  >
                    {% if product.available %}
                      Add to Cart
                    {% else %}
                      Sold Out
                    {% endif %}
                  </button>
                {% endif %}
              </div>
            </div>
          {% endfor %}
        {% else %}
          {% for i in (1..4) %}
            <div class="ai-carousel-card-{{ai_gen_id}}">
              <div class="ai-carousel-image-wrapper-{{ai_gen_id}}">
                <div class="ai-carousel-image-placeholder-{{ai_gen_id}}">
                  {{ 'product-1' | placeholder_svg_tag }}
                </div>
              </div>
              <div class="ai-carousel-content-{{ai_gen_id}}">
                {% if show_title %}
                  <h3 class="ai-carousel-product-title-{{ai_gen_id}}">Product Title</h3>
                {% endif %}
                {% if show_price %}
                  <div class="ai-carousel-price-wrapper-{{ai_gen_id}}">
                    <span class="ai-carousel-price-{{ai_gen_id}}">$99.00</span>
                  </div>
                {% endif %}
                {% if show_add_to_cart %}
                  <button class="ai-carousel-add-to-cart-{{ai_gen_id}}" disabled type="button">
                    Add to Cart
                  </button>
                {% endif %}
              </div>
            </div>
          {% endfor %}
        {% endif %}
      </div>
    </div>
  </div>
</featured-carousel-{{ai_gen_id}}>

<script>
(function() {
  class FeaturedCarousel{{ai_gen_id}} extends HTMLElement {
    constructor() {
      super();
      this.track = this.querySelector('.ai-carousel-track-{{ai_gen_id}}');
      this.leftArrow = this.querySelector('.ai-carousel-arrow-left-{{ai_gen_id}}');
      this.rightArrow = this.querySelector('.ai-carousel-arrow-right-{{ai_gen_id}}');
      this.cards = this.querySelectorAll('.ai-carousel-card-{{ai_gen_id}}');
      this.autoRotate = {{ auto_rotate }};
      this.slideInterval = {{ slide_interval | times: 1000 }};
      this.autoRotateTimer = null;
    }

    connectedCallback() {
      this.setupNavigation();
      this.setupAddToCart();
      if (this.autoRotate && this.cards.length > 0) {
        this.startAutoRotate();
        this.track.addEventListener('mouseenter', () => this.stopAutoRotate());
        this.track.addEventListener('mouseleave', () => this.startAutoRotate());
        this.track.addEventListener('touchstart', () => this.stopAutoRotate());
      }
    }

    setupNavigation() {
      if (this.leftArrow) {
        this.leftArrow.addEventListener('click', () => this.scroll('left'));
      }
      if (this.rightArrow) {
        this.rightArrow.addEventListener('click', () => this.scroll('right'));
      }

      this.track.addEventListener('keydown', (e) => {
        if (e.key === 'ArrowLeft') {
          this.scroll('left');
        } else if (e.key === 'ArrowRight') {
          this.scroll('right');
        }
      });
    }

    scroll(direction) {
      if (this.cards.length === 0) return;
      
      const cardWidth = this.cards[0].offsetWidth;
      const gap = {{ card_spacing }};
      const scrollAmount = cardWidth + gap;
      
      if (direction === 'left') {
        this.track.scrollBy({ left: -scrollAmount, behavior: 'smooth' });
      } else {
        this.track.scrollBy({ left: scrollAmount, behavior: 'smooth' });
      }
    }

    startAutoRotate() {
      this.autoRotateTimer = setInterval(() => {
        const maxScroll = this.track.scrollWidth - this.track.clientWidth;
        if (this.track.scrollLeft >= maxScroll - 10) {
          this.track.scrollTo({ left: 0, behavior: 'smooth' });
        } else {
          this.scroll('right');
        }
      }, this.slideInterval);
    }

    stopAutoRotate() {
      if (this.autoRotateTimer) {
        clearInterval(this.autoRotateTimer);
        this.autoRotateTimer = null;
      }
    }

    setupAddToCart() {
      const buttons = this.querySelectorAll('.ai-carousel-add-to-cart-{{ai_gen_id}}');
      buttons.forEach(button => {
        button.addEventListener('click', (e) => {
          const variantId = e.target.dataset.variantId;
          if (!variantId || button.disabled) return;

          const originalText = button.textContent;
          button.textContent = 'Adding...';
          button.disabled = true;

          fetch('/cart/add.js', {
            method: 'POST',
            headers: {
              'Content-Type': 'application/json',
            },
            body: JSON.stringify({
              items: [{
                id: variantId,
                quantity: 1
              }]
            })
          })
          .then(response => response.json())
          .then(data => {
            button.textContent = 'Added!';
            setTimeout(() => {
              button.textContent = originalText;
              button.disabled = false;
            }, 2000);

            if (window.theme && window.theme.cart) {
              window.theme.cart.refresh();
            }
            document.dispatchEvent(new CustomEvent('cart:updated'));
          })
          .catch(error => {
            console.error('Error adding to cart:', error);
            button.textContent = 'Error';
            setTimeout(() => {
              button.textContent = originalText;
              button.disabled = false;
            }, 2000);
          });
        });
      });
    }

    disconnectedCallback() {
      this.stopAutoRotate();
    }
  }

  customElements.define('featured-carousel-{{ai_gen_id}}', FeaturedCarousel{{ai_gen_id}});
})();
</script>

