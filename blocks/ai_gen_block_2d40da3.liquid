{% doc %}
  @prompt
    Generate an announcement bar having logo inserting option, Generate an announcement bar having logo inserting option with full controls setting. And make it only for mobile version. The logo should not me shown in desktop version only to be shown on mobile version., the logo should be positioned in the center, the logo should be positioned in the middle center and also include additional postioning settings to the logo.
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-announcement-bar-{{ ai_gen_id }} {
    display: none;
    width: 100%;
    background-color: {{ block.settings.background_color }};
    color: {{ block.settings.text_color }};
    padding: {{ block.settings.padding_top }}px {{ block.settings.padding_horizontal }}px {{ block.settings.padding_bottom }}px;
    text-align: {{ block.settings.text_alignment }};
    border-top: {{ block.settings.border_top_width }}px solid {{ block.settings.border_color }};
    border-bottom: {{ block.settings.border_bottom_width }}px solid {{ block.settings.border_color }};
  }

  .ai-announcement-bar-container-{{ ai_gen_id }} {
    max-width: 100%;
    margin: 0 auto;
    display: flex;
    {% if block.settings.logo_position == 'top' %}
      flex-direction: column;
    {% elsif block.settings.logo_position == 'bottom' %}
      flex-direction: column-reverse;
    {% elsif block.settings.logo_position == 'left' %}
      flex-direction: row;
    {% elsif block.settings.logo_position == 'right' %}
      flex-direction: row-reverse;
    {% endif %}
    align-items: {{ block.settings.logo_vertical_alignment }};
    justify-content: {{ block.settings.logo_horizontal_alignment }};
    gap: {{ block.settings.logo_text_gap }}px;
  }

  .ai-announcement-bar-logo-{{ ai_gen_id }} {
    flex-shrink: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    {% if block.settings.logo_position == 'left' or block.settings.logo_position == 'right' %}
      margin-top: {{ block.settings.logo_margin_top }}px;
      margin-bottom: {{ block.settings.logo_margin_bottom }}px;
    {% endif %}
  }

  .ai-announcement-bar-logo-{{ ai_gen_id }} img {
    width: {% if block.settings.logo_width_auto %}auto{% else %}{{ block.settings.logo_width }}px{% endif %};
    height: {{ block.settings.logo_height }}px;
    object-fit: {{ block.settings.logo_object_fit }};
    border-radius: {{ block.settings.logo_border_radius }}px;
    opacity: {{ block.settings.logo_opacity }};
  }

  .ai-announcement-bar-logo-{{ ai_gen_id }} img:hover {
    opacity: {{ block.settings.logo_hover_opacity }};
  }

  .ai-announcement-bar-logo-placeholder-{{ ai_gen_id }} {
    width: {{ block.settings.logo_height }}px;
    height: {{ block.settings.logo_height }}px;
    background-color: rgba(0, 0, 0, 0.1);
    border-radius: {{ block.settings.logo_border_radius }}px;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .ai-announcement-bar-logo-placeholder-{{ ai_gen_id }} svg {
    width: 60%;
    height: 60%;
    opacity: 0.3;
  }

  .ai-announcement-bar-content-{{ ai_gen_id }} {
    {% if block.settings.logo_position == 'top' or block.settings.logo_position == 'bottom' %}
      width: 100%;
    {% else %}
      flex: 1;
    {% endif %}
    font-size: {{ block.settings.font_size }}px;
    line-height: {{ block.settings.line_height }};
    font-weight: {{ block.settings.font_weight }};
    letter-spacing: {{ block.settings.letter_spacing }}px;
  }

  .ai-announcement-bar-content-{{ ai_gen_id }} p {
    margin: 0;
  }

  .ai-announcement-bar-content-{{ ai_gen_id }} a {
    color: {{ block.settings.link_color }};
    text-decoration: {% if block.settings.link_underline %}underline{% else %}none{% endif %};
    font-weight: {{ block.settings.link_font_weight }};
  }

  .ai-announcement-bar-content-{{ ai_gen_id }} a:hover {
    opacity: {{ block.settings.link_hover_opacity }};
    text-decoration: {% if block.settings.link_hover_underline %}underline{% else %}none{% endif %};
  }

  @media screen and (max-width: 749px) {
    .ai-announcement-bar-{{ ai_gen_id }} {
      display: block;
    }
  }

  @media screen and (min-width: 750px) {
    .ai-announcement-bar-{{ ai_gen_id }} {
      display: none !important;
    }
  }
{% endstyle %}

<announcement-bar-mobile-{{ ai_gen_id }} class="ai-announcement-bar-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-announcement-bar-container-{{ ai_gen_id }}">
    {% if block.settings.show_logo %}
      <div class="ai-announcement-bar-logo-{{ ai_gen_id }}">
        {% if block.settings.logo != blank %}
          {% if block.settings.logo_link != blank %}
            <a href="{{ block.settings.logo_link }}">
              <img
                src="{{ block.settings.logo | image_url: width: 400 }}"
                alt="{{ block.settings.logo.alt | escape }}"
                loading="lazy"
                width="{{ block.settings.logo.width }}"
                height="{{ block.settings.logo.height }}"
              >
            </a>
          {% else %}
            <img
              src="{{ block.settings.logo | image_url: width: 400 }}"
              alt="{{ block.settings.logo.alt | escape }}"
              loading="lazy"
              width="{{ block.settings.logo.width }}"
              height="{{ block.settings.logo.height }}"
            >
          {% endif %}
        {% else %}
          <div class="ai-announcement-bar-logo-placeholder-{{ ai_gen_id }}">
            {{ 'image' | placeholder_svg_tag }}
          </div>
        {% endif %}
      </div>
    {% endif %}

    <div class="ai-announcement-bar-content-{{ ai_gen_id }}">
      {% if block.settings.announcement_text != blank %}
        {{ block.settings.announcement_text }}
      {% else %}
        <p>Add your mobile announcement text here</p>
      {% endif %}
    </div>
  </div>
</announcement-bar-mobile-{{ ai_gen_id }}>

<script>
  (function() {
    class AnnouncementBarMobile{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
      }

      connectedCallback() {
      }
    }

    customElements.define('announcement-bar-mobile-{{ ai_gen_id }}', AnnouncementBarMobile{{ ai_gen_id }});
  })();
</script>

{% schema %}
{
  "name": "Announcement bar mobile",
  "settings": [
    {
      "type": "header",
      "content": "Visibility"
    },
    {
      "type": "paragraph",
      "content": "This announcement bar is only visible on mobile devices (screen width below 750px). It will be hidden on desktop."
    },
    {
      "type": "header",
      "content": "Logo"
    },
    {
      "type": "checkbox",
      "id": "show_logo",
      "label": "Show logo",
      "default": true
    },
    {
      "type": "image_picker",
      "id": "logo",
      "label": "Logo image"
    },
    {
      "type": "url",
      "id": "logo_link",
      "label": "Logo link"
    },
    {
      "type": "header",
      "content": "Logo position"
    },
    {
      "type": "select",
      "id": "logo_position",
      "label": "Position",
      "options": [
        {
          "value": "top",
          "label": "Top"
        },
        {
          "value": "bottom",
          "label": "Bottom"
        },
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ],
      "default": "top"
    },
    {
      "type": "select",
      "id": "logo_horizontal_alignment",
      "label": "Horizontal alignment",
      "options": [
        {
          "value": "flex-start",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "flex-end",
          "label": "Right"
        }
      ],
      "default": "center",
      "info": "Controls horizontal positioning of the entire bar content"
    },
    {
      "type": "select",
      "id": "logo_vertical_alignment",
      "label": "Vertical alignment",
      "options": [
        {
          "value": "flex-start",
          "label": "Top"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "flex-end",
          "label": "Bottom"
        }
      ],
      "default": "center",
      "info": "Controls vertical alignment when logo is left or right"
    },
    {
      "type": "range",
      "id": "logo_margin_top",
      "label": "Logo margin top",
      "min": 0,
      "max": 30,
      "step": 5,
      "unit": "px",
      "default": 0,
      "info": "Only applies when logo is left or right"
    },
    {
      "type": "range",
      "id": "logo_margin_bottom",
      "label": "Logo margin bottom",
      "min": 0,
      "max": 30,
      "step": 5,
      "unit": "px",
      "default": 0,
      "info": "Only applies when logo is left or right"
    },
    {
      "type": "header",
      "content": "Logo size"
    },
    {
      "type": "range",
      "id": "logo_height",
      "label": "Height",
      "min": 15,
      "max": 100,
      "step": 5,
      "unit": "px",
      "default": 30
    },
    {
      "type": "checkbox",
      "id": "logo_width_auto",
      "label": "Auto width",
      "default": true,
      "info": "Maintains aspect ratio. Disable to set custom width."
    },
    {
      "type": "range",
      "id": "logo_width",
      "label": "Width",
      "min": 30,
      "max": 200,
      "step": 10,
      "unit": "px",
      "default": 80,
      "info": "Only applies when auto width is disabled"
    },
    {
      "type": "select",
      "id": "logo_object_fit",
      "label": "Image fit",
      "options": [
        {
          "value": "contain",
          "label": "Contain"
        },
        {
          "value": "cover",
          "label": "Cover"
        },
        {
          "value": "fill",
          "label": "Fill"
        }
      ],
      "default": "contain"
    },
    {
      "type": "header",
      "content": "Logo style"
    },
    {
      "type": "range",
      "id": "logo_border_radius",
      "label": "Border radius",
      "min": 0,
      "max": 50,
      "step": 5,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "logo_opacity",
      "label": "Opacity",
      "min": 0.5,
      "max": 1,
      "step": 0.1,
      "default": 1
    },
    {
      "type": "range",
      "id": "logo_hover_opacity",
      "label": "Hover opacity",
      "min": 0.5,
      "max": 1,
      "step": 0.1,
      "default": 0.8
    },
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "richtext",
      "id": "announcement_text",
      "label": "Announcement text",
      "default": "<p>Welcome! Free shipping on orders over $50</p>"
    },
    {
      "type": "header",
      "content": "Typography"
    },
    {
      "type": "range",
      "id": "font_size",
      "label": "Font size",
      "min": 10,
      "max": 24,
      "step": 1,
      "unit": "px",
      "default": 13
    },
    {
      "type": "range",
      "id": "line_height",
      "label": "Line height",
      "min": 1,
      "max": 2,
      "step": 0.1,
      "default": 1.4
    },
    {
      "type": "select",
      "id": "font_weight",
      "label": "Font weight",
      "options": [
        {
          "value": "300",
          "label": "Light"
        },
        {
          "value": "400",
          "label": "Normal"
        },
        {
          "value": "500",
          "label": "Medium"
        },
        {
          "value": "600",
          "label": "Semi bold"
        },
        {
          "value": "700",
          "label": "Bold"
        }
      ],
      "default": "400"
    },
    {
      "type": "range",
      "id": "letter_spacing",
      "label": "Letter spacing",
      "min": 0,
      "max": 5,
      "step": 0.5,
      "unit": "px",
      "default": 0
    },
    {
      "type": "header",
      "content": "Link style"
    },
    {
      "type": "checkbox",
      "id": "link_underline",
      "label": "Underline links",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "link_hover_underline",
      "label": "Underline on hover",
      "default": true
    },
    {
      "type": "select",
      "id": "link_font_weight",
      "label": "Link font weight",
      "options": [
        {
          "value": "400",
          "label": "Normal"
        },
        {
          "value": "500",
          "label": "Medium"
        },
        {
          "value": "600",
          "label": "Semi bold"
        },
        {
          "value": "700",
          "label": "Bold"
        }
      ],
      "default": "600"
    },
    {
      "type": "range",
      "id": "link_hover_opacity",
      "label": "Link hover opacity",
      "min": 0.5,
      "max": 1,
      "step": 0.1,
      "default": 0.8
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "select",
      "id": "text_alignment",
      "label": "Text alignment",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ],
      "default": "center"
    },
    {
      "type": "range",
      "id": "logo_text_gap",
      "label": "Logo to text gap",
      "min": 5,
      "max": 40,
      "step": 5,
      "unit": "px",
      "default": 10
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Padding top",
      "min": 0,
      "max": 50,
      "step": 5,
      "unit": "px",
      "default": 10
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Padding bottom",
      "min": 0,
      "max": 50,
      "step": 5,
      "unit": "px",
      "default": 10
    },
    {
      "type": "range",
      "id": "padding_horizontal",
      "label": "Padding horizontal",
      "min": 10,
      "max": 50,
      "step": 5,
      "unit": "px",
      "default": 15
