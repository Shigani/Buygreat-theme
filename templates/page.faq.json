          "settings": {
            "heading": "Split Shipments",
            "content": "<p>Some orders may be shipped in <strong>multiple parcels,</strong> especially if items are sourced from different warehouses.</p><p><br/>If this happens, you may receive <strong>multiple tracking numbers.</strong><br/><br/></p>"
