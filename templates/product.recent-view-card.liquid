{%- layout none -%}
<div class="swiper-slide buygreat-recent-view-slide">
  {%- if product.tags != blank -%}
    <div class="buygreat-product-gallery-card__tags buygreat-trending-product-tags" aria-label="Product tags">
      {%- for product_tag in product.tags -%}
        {%- assign normalized_product_tag = product_tag | downcase | strip | replace: ' ', '-' -%}
        {%- assign tag_modifier = 'default' -%}
        {%- if normalized_product_tag == 'sale' -%}
          {%- assign tag_modifier = 'sale' -%}
        {%- elsif normalized_product_tag == 'new' or normalized_product_tag == 'new-arrival' or normalized_product_tag == 'new-arrivals' -%}
          {%- assign tag_modifier = 'new' -%}
        {%- elsif normalized_product_tag == 'bestseller' or normalized_product_tag == 'best-seller' -%}
          {%- assign tag_modifier = 'bestseller' -%}
        {%- endif -%}
        <span class="buygreat-product-gallery-card__tag buygreat-product-gallery-card__tag--{{ tag_modifier }}">
          {{ product_tag | escape }}
        </span>
      {%- endfor -%}
    </div>
  {%- endif -%}

  {% render 'product-card-item',
    product_card_product: product,
    media_size: 'adapt',
    show_secondary_image: false,
    show_vendor: false,
    show_badge: false,
    show_cart_button: false,
    cart_button_style: 'style2',
    cart_button_place: 'bottom_right',
    show_countdown: false,
    show_title: true,
    show_price: true,
    show_rating: true,
    is_product_options: true
  %}
</div>

