{%- assign trending_collection = block.settings.collection -%}
{%- if trending_collection != blank -%}
  {%- assign trending_products = trending_collection.products -%}
{%- else -%}
  {%- assign trending_products = collections.all.products -%}
{%- endif -%}

<div
  class="buygreat-trending-products buygreat-product-info-trending"
  data-section-id="{{ section.id }}-{{ block.id }}"
  data-section-type="product-slider"
  data-slider-enable="true"
  data-show-mobile="{{ block.settings.products_show_on_sm }}"
  data-show-extra-large="{{ block.settings.products_show_on_xl }}"
  data-slider-space="0"
  data-autoplay="false"
  data-autoplay-time="3000"
  {{ block.shopify_attributes }}
>
  <h2 class="product-recommendations__heading h2">
    {{ block.settings.heading | escape }}
  </h2>
  <div class="relative product_slider_wrapper">
    <div class="productSlider swiper" role="list">
      <div class="swiper-wrapper">
        {%- for recommendation in trending_products limit: block.settings.products_to_show -%}
          <div class="swiper-slide">
            {% render 'product-card-item',
              product_card_product: recommendation,
              media_size: block.settings.image_ratio,
              show_secondary_image: false,
              show_vendor: false,
              show_badge: block.settings.show_badges,
              show_cart_button: false,
              cart_button_style: 'style2',
              cart_button_place: 'bottom_right',
              show_countdown: false,
              show_countdown_on_image: false,
              show_title: true,
              show_price: true,
              show_rating: false,
              is_product_options: true
            %}
          </div>
        {%- endfor -%}
      </div>
    </div>
  </div>
  <div class="featured__collection--slider slider--controls--button">
    <div class="swiper-button-next product__slider--buton" aria-label="Next products"></div>
  </div>
</div>

