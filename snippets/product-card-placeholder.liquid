{% comment %}
    Renders a product card placeholder

    Usage:
    {% render 'product-card-placeholder' %}
{% endcomment %}

<div class="{{ productItem }}">
  <div class="product-grid-item {{ placeholder_class }}">
    <div class="product-grid-item__thumbnail">
      <a href="#" class="d-block product__media_thumbnail" aria-hidden="true" tabindex="-1">
        <div
          class="media media--{{ media_size | default: 'adapt' }} placeholder placeholder_svg_parent"
          {% if media_size == blank or media_size == 'adapt' %}
            style="padding-bottom: 100%"
          {% endif %}
        >
          {{ product_item | placeholder_svg_tag: 'placeholder-svg' }}
        </div>
      </a>
    </div>

    <div class="product-grid-item__content text-{{ settings.product_content_alignment }}">
      {%- if show_rating -%}
        <div class="product-card--rating" aria-hidden="true">
          <div class="rating">
            <span
              class="rating-star rating-star--placeholder color-icon-{{ settings.accent_icons }}"
              style="--rating: 0; --rating-max: 5; --rating-decimal: 0;"
            ></span>
          </div>
        </div>
      {%- endif -%}

      <div class="product-grid-item__titles">
        {%- if show_title -%}
          <h3 class="product-grid-item__title {{ settings.product_title_size }}">
            {{ 'products.product.placeholder_title' | t }}
          </h3>
        {%- endif -%}
      </div>

      {%- if show_price -%}
        <div class="price product-grid-item__price justify-content-start">
          <dl>
            <div class="price__regular">
              <dd class="price__last">
                <span class="price-item price-item--regular">
                  {{ 'products.product.placeholder_price' | t }}
                </span>
              </dd>
            </div>
          </dl>
        </div>
      {%- endif -%}
    </div>
  </div>
</div>
