{%- liquid
  assign media_ratio = image_ratio | default: 'adapt'
  assign custom_description = card_description | default: '' | strip_html | strip
  if custom_image != blank
    assign media_aspect_ratio = custom_image.aspect_ratio
  elsif collection.featured_image != blank
    assign media_aspect_ratio = collection.featured_image.aspect_ratio
  endif
-%}

<a
  {% if collection.all_products_count > 0 %}
    href="{{ collection.url }}"
  {% endif %}
  class="{% if collection.featured_image != blank or custom_image != blank %} card--media{% else %}{% if media_ratio != 'adapt' %} card--stretch{% endif %}{% endif %} collection__card"
>
  <div class="card--stretch">
    {% unless content_position %}<div class="collection--card-wrapper">{% endunless %}
    {%- if collection.featured_image != blank or custom_image != blank -%}
      <div
        class="media media--{{ media_ratio }} {% if radius and media_ratio != "circle" %} rounded--3rem {% endif %} {% if round_image %} collection--rounded-media {% endif %} media--hover-effect overflow-hidden card--client-height"
        {% if media_ratio == 'adapt' and media_aspect_ratio != blank %}
          style="padding-bottom: {{ 1 | divided_by: media_aspect_ratio | times: 100 }}%;"
        {% endif %}
      >
        {% if custom_image != blank %}
          {%- capture sizes -%} (min-width: 768px) {% if columns > 1 %}calc((100vw - 10rem) / 2){% else %}calc(100vw - 10rem){% endif %}, calc(100vw - 3rem) {%- endcapture -%}
          {% liquid
            assign height = custom_image.width | divided_by: custom_image.aspect_ratio | round
          %}
          {{
            custom_image
            | image_url: width: 1500
            | image_tag:
              loading: 'lazy',
              height: height,
              sizes: sizes,
              widths: '165, 360, 750, 1000, 1500, 1780, 2000, 3000, 3840'
          }}
          
        {% else %}
          <img
            srcset="
              {%- if collection.featured_image.width >= 165 -%}{{ collection.featured_image | img_url: '165x' }} 165w,{%- endif -%}
                 {%- if collection.featured_image.width >= 360 -%}{{ collection.featured_image | img_url: '360x' }} 360w,{%- endif -%}
                 {%- if collection.featured_image.width >= 535 -%}{{ collection.featured_image | img_url: '535x' }} 535w,{%- endif -%}
                 {%- if collection.featured_image.width >= 750 -%}{{ collection.featured_image | img_url: '750x' }} 750w,{%- endif -%}
                 {%- if collection.featured_image.width >= 1000 -%}{{ collection.featured_image | img_url: '1000x' }} 1000w,{%- endif -%}
                 {%- if collection.featured_image.width >= 1500 -%}{{ collection.featured_image | img_url: '1500x' }} 1500w,{%- endif -%}
              {%- if collection.featured_image.width >= 1780 -%}{{ collection.featured_image | img_url: '1780x' }} 1780w,{%- endif -%}
                 {%- if collection.featured_image.width >= 2000 -%}{{ collection.featured_image | img_url: '2000x' }} 2000w,{%- endif -%}
                 {%- if collection.featured_image.width >= 3000 -%}{{ collection.featured_image | img_url: '3000x' }} 3000w,{%- endif -%}
                 {%- if collection.featured_image.width >= 3840 -%}{{ collection.featured_image | img_url: '3840x' }} 3840w,{%- endif -%}
                 {{ collection.featured_image | img_url: 'master' }} {{ collection.featured_image.width }}w
            "
            src="{{ collection.featured_image | img_url: '1500x' }}"
            sizes="(min-width: 768px) {% if columns > 1 %}calc((100vw - 10rem) / 2){% else %}calc(100vw - 10rem){% endif %}, calc(100vw - 3rem)"
            alt="{{ collection.title | escape }}"
            height="{{ collection.featured_image.height | divided_by: collection.featured_image.aspect_ratio }}"
            width="{{ collection.featured_image.width  }}"
            loading="lazy"
          >
        {% endif %}
      </div>
    {%- else -%}
      <div
        class="placeholder_svg_parent {% if radius and media_ratio != "circle" %} rounded--3rem {% endif %} {% if round_image %}rounded--image{% endif %} media--{{ media_ratio }} card--client-height"
        {% if media_ratio == 'adapt' %}
          style="padding-bottom: 100%"
        {% endif %}
      >
        {% capture current %}{% cycle 1, 2, 3, 4, 5, 6 %}{% endcapture %}
        {{ 'collection-' | append: current | placeholder_svg_tag: 'placeholder-svg' }}
      </div>
    {%- endif -%}

    {%- if collection != blank -%}
      {%- liquid
        assign collection_description = custom_description
        if collection_description == blank
          assign collection_description = collection.description | strip_html | strip
        endif
        if collection_description == blank
          case collection.handle
            when 'home-and-living'
              assign collection_description = 'sections.collection_list.descriptions.home_and_living' | t
            when 'appliances'
              assign collection_description = 'sections.collection_list.descriptions.appliances' | t
            when 'electronics'
              assign collection_description = 'sections.collection_list.descriptions.electronics' | t
            when 'furniture'
              assign collection_description = 'sections.collection_list.descriptions.furniture' | t
            when 'sports-and-fitness'
              assign collection_description = 'sections.collection_list.descriptions.sports_and_fitness' | t
            when 'baby-and-kids'
              assign collection_description = 'sections.collection_list.descriptions.baby_and_kids' | t
            when 'outdoor'
              assign collection_description = 'sections.collection_list.descriptions.outdoor' | t
            when 'auto-accessories'
              assign collection_description = 'sections.collection_list.descriptions.auto_accessories' | t
          endcase
        endif
      -%}
      <div class="collection__card_text{% if section.settings.column == "5" %} column__five--design {% endif %}  {% unless content_position %} collection--content-absolute {% endunless %} {% if show_content_below_image_mobile %} collection--normal-on-mobile{% endif %}">
        {% if title_design == 'button' %}
          {%- liquid
            case button_type
              when 'primary'
                assign button_class = 'button'
              when 'secondary'
                assign button_class = 'button button--secondary'
            endcase
          -%}
          <button
            class="collection--card-button {{ button_class }} button--{{ button_size }}"
            {% if use_custom_color %}
              style="--color-button-text: {{ button_foreground_color.red }}, {{ button_foreground_color.green }}, {{ button_foreground_color.blue }}; --color-button: {{ button_background_color.red }}, {{ button_background_color.green }}, {{ button_background_color.blue }};"
            {% endif %}
          >
            {{- collection.title -}}
            {% if use_arrow_icon %}
              {% if icon_type == 'arrow_up' %}
                {% render 'icon-arrow-up-right' %}
              {% else %}
                {% render 'icon-right-arrow' %}
              {% endif %}
            {% endif %}
          </button>
        {% else %}
          <h3 class="collection__title mb-0 {{ title_size }}">
            {{- collection.title -}}
            {% if use_arrow_icon %}
              {% if icon_type == 'arrow_up' %}
                {% render 'icon-arrow-up-right' %}
              {% else %}
                {% render 'icon-right-arrow' %}
              {% endif %}
            {% endif %}
          </h3>
          {% if collection_description != blank %}
            <p class="collection__description">{{ collection_description | truncate: 72 }}</p>
          {% endif %}
          <span class="collection__card_link">
            {{ 'sections.collection_list.shop_now' | t }} <span aria-hidden="true">→</span>
          </span>
        {% endif %}
      </div>
    {%- else -%}
      <div class="collection__card_text placeholder__position {% if section.settings.column == "5" %} column__five--design {% endif %} text-center {% unless content_position %} collection--content-absolute {% endunless %} {% if show_content_below_image_mobile %} collection--normal-on-mobile{% endif %}">
        {% if title_design == 'button' %}
          {%- liquid
            case button_type
              when 'primary'
                assign button_class = 'button'
              when 'secondary'
                assign button_class = 'button button--secondary'
            endcase
          -%}
          <button
            class="collection--card-button  {{ button_class }} button--{{ button_size }}"
            {% if use_custom_color %}
              style="--color-button-text: {{ button_foreground_color.red }}, {{ button_foreground_color.green }}, {{ button_foreground_color.blue }}; --color-button: {{ button_background_color.red }}, {{ button_background_color.green }}, {{ button_background_color.blue }};"
            {% endif %}
          >
            {{ 'sections.collection_list.default_title' | t }}
            {% if use_arrow_icon %}
              {% if icon_type == 'arrow_up' %}
                {% render 'icon-arrow-up-right' %}
              {% else %}
                {% render 'icon-right-arrow' %}
              {% endif %}
            {% endif %}
          </button>
        {% else %}
   
          <h3 class="collection__title mb-0 {{ title_size }}">
            {{ 'sections.collection_list.default_title' | t }}
            {% if use_arrow_icon %}
              {% if icon_type == 'arrow_up' %}
                {% render 'icon-arrow-up-right' %}
              {% else %}
                {% render 'icon-right-arrow' %}
              {% endif %}
            {% endif %}
          </h3>

          {% if custom_description != blank %}
            <p class="collection__description">{{ custom_description | truncate: 72 }}</p>
          {% endif %}

          <span class="collection__card_link">
            {{ 'sections.collection_list.shop_now' | t }} <span aria-hidden="true">→</span>
          </span>

        {% endif %}
      </div>
    {%- endif -%}
    {% unless content_position %}</div>{% endunless %}
  </div>
</a>
